{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signup Tool",
  "description": "MCP tool for user registration via external auth API",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "signup",
      "description": "Tool identifier"
    },
    "description": {
      "type": "string",
      "const": "Register new user account with email and password, returns JWT token for immediate access"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address (must be unique)",
          "example": "newuser@example.com"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "Desired password (strength validated by external API)",
          "example": "SecurePassword123!"
        },
        "firstName": {
          "type": "string",
          "maxLength": 100,
          "description": "User's first name (optional)",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "maxLength": 100,
          "description": "User's last name (optional)",
          "example": "Doe"
        }
      },
      "required": ["email", "password"],
      "additionalProperties": false
    },
    "outputSchema": {
      "oneOf": [
        {
          "title": "Success Response",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "message": {
              "type": "string",
              "example": "Signup successful"
            },
            "userId": {
              "type": "string",
              "description": "Newly created user identifier",
              "example": "usr_9876543210"
            }
          },
          "required": ["success", "message", "userId"]
        },
        {
          "title": "Error Response",
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error type",
              "enum": ["user_exists", "validation_error", "network_error", "server_error"]
            },
            "details": {
              "type": "string",
              "description": "Human-readable error message",
              "example": "An account with this email already exists"
            }
          },
          "required": ["error"]
        }
      ]
    }
  },
  "examples": [
    {
      "name": "Successful signup",
      "input": {
        "email": "newuser@example.com",
        "password": "SecurePassword123!",
        "firstName": "Jane",
        "lastName": "Smith"
      },
      "output": {
        "success": true,
        "message": "Signup successful",
        "userId": "usr_9876543210"
      }
    },
    {
      "name": "Email already exists",
      "input": {
        "email": "existing@example.com",
        "password": "SecurePassword123!"
      },
      "output": {
        "error": "user_exists",
        "details": "An account with this email already exists"
      }
    },
    {
      "name": "Minimal signup (no names)",
      "input": {
        "email": "minimal@example.com",
        "password": "SecurePassword123!"
      },
      "output": {
        "success": true,
        "message": "Signup successful",
        "userId": "usr_1111111111"
      }
    }
  ]
}
