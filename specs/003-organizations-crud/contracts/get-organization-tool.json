{
  "name": "get-organization",
  "description": "Retrieve detailed information about a specific organization by its unique identifier. Returns complete organization details including name, description, and timestamps.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier of the organization to retrieve (required). This is the ID returned when the organization was created or from the get-all-organizations tool.",
        "minLength": 1
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "annotations": {
    "authentication": "required",
    "httpMethod": "GET",
    "endpoint": "/organizations/{id}",
    "successStatus": 200
  },
  "examples": [
    {
      "description": "Get organization by ID",
      "input": {
        "id": "org-123"
      },
      "expectedResponse": {
        "data": {
          "id": "org-123",
          "name": "Acme Corporation",
          "description": "Leading provider of innovative solutions",
          "createdAt": "2025-11-20T10:00:00Z",
          "updatedAt": "2025-11-20T10:00:00Z"
        }
      }
    }
  ],
  "errors": [
    {
      "status": 404,
      "description": "Organization not found with the specified ID",
      "example": {
        "error": {
          "message": "Organization not found",
          "code": "NOT_FOUND"
        }
      }
    },
    {
      "status": 400,
      "description": "Invalid organization ID format",
      "example": {
        "error": {
          "message": "Invalid organization ID format",
          "code": "INVALID_ID"
        }
      }
    },
    {
      "status": 403,
      "description": "Insufficient permissions to view this organization",
      "example": {
        "error": {
          "message": "Access denied. Insufficient permissions.",
          "code": "FORBIDDEN"
        }
      }
    }
  ]
}
